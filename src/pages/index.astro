---
import Layout from '../layouts/Layout.astro';
import TutorialCard from '../components/TutorialCard.astro';
import { getCollection } from 'astro:content';

const tutorials = await getCollection('tutorials');
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="首页">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <h1 class="text-5xl font-black text-white mb-3">
      掌握 <span class="text-ue-accent">Unreal Engine</span>
    </h1>
    <p class="text-gray-400 mb-8">课后随时查阅的内部教程站</p>

    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-white">最新课程</h2>
      <a class="text-ue-accent text-sm hover:underline" href={`${baseUrl}tutorials/`}>查看全部 →</a>
    </div>

    {tutorials.length === 0 ? (
      <div class="glass p-6 rounded-xl text-gray-300 border border-ue-border">
        还没有课程内容。请把 Markdown 放到 <code>src/content/tutorials</code> 目录。
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tutorials.map((t) => (
          <TutorialCard tutorial={t} />
        ))}
      </div>
    )}
  </div>
</Layout>
