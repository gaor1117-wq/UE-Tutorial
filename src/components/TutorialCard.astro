---
const { tutorial } = Astro.props;
const { data, slug } = tutorial;
const baseUrl = import.meta.env.BASE_URL;
// 统一用文件名(slug)作为路由
---
<a href={`${baseUrl}/tutorials/${slug}`} 
   class="tutorial-card glass rounded-lg overflow-hidden group block relative transition-all duration-300"
   data-tags={data.tags.join(',')} data-effects={data.effects.join(',')}>
  
  <div class="h-40 bg-ue-dark relative border-b border-ue-border overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent z-10"></div>
    <div class="absolute inset-0 flex items-center justify-center text-ue-border text-4xl font-bold group-hover:scale-110 transition-transform duration-500">
      UE {data.ueVersion}
    </div>
    <div class="absolute bottom-3 left-3 z-20 flex gap-2">
      <span class="px-2 py-1 text-[10px] bg-ue-accent/20 text-ue-accent rounded border border-ue-accent/30">{data.level}</span>
      <span class="px-2 py-1 text-[10px] bg-gray-800/80 text-gray-300 rounded">{data.durationMin}m</span>
    </div>
  </div>
  
  <div class="p-4 relative">
    <div class="absolute -top-10 -right-10 w-20 h-20 bg-ue-accent/20 rounded-full blur-2xl group-hover:bg-ue-accent/40 transition-colors"></div>
    <h3 class="text-lg font-bold text-white mb-2 group-hover:text-ue-accent transition-colors line-clamp-1">{data.title}</h3>
    <p class="text-xs text-gray-400 line-clamp-2 mb-3 h-8">{data.summary}</p>
    
    <div class="flex flex-wrap gap-1">
      {data.tags.slice(0,3).map((tag: string) => (
        <span class="text-[10px] text-gray-500 bg-ue-dark px-1.5 py-0.5 rounded border border-ue-border">#{tag}</span>
      ))}
    </div>
  </div>
</a>

<script>
  const cards = document.querySelectorAll('.tutorial-card');
  cards.forEach(card => {
    card.addEventListener('mousemove', (e: any) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -5;
      const rotateY = ((x - centerX) / centerX) * 5;
      
      (card as HTMLElement).style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
    });
    
    card.addEventListener('mouseleave', () => {
      (card as HTMLElement).style.transform = `perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)`;
    });
  });
</script>
